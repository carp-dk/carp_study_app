      "request": "launch",
      "type": "dart",
      "toolArgs": [
        "--dart-define",
        "deployment-mode=test",
        "--dart-define",
        "debug-level=debug"
      ],
      "flutterMode": "debug"
    },
    {
      // debug mode using COMPUTEROME CAWS instance
