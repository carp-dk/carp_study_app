      "name": "Integration - join study flow (LOCAL)",
      "request": "launch",
      "type": "dart",
      "program": "integration_test/join_study_flow_test.dart",
      "toolArgs": [
        "--dart-define",
        "deployment-mode=local",
        "--dart-define",
        "debug-level=debug"
